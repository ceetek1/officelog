# Copy to .env for local development. In production (Railway) set these as service variables.

# Database owner. Used only to run migrations and to set up the app's own role.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/officelog
# The app connects as this restricted role (it cannot edit scans or the activity log).
APP_DB_ROLE=attendance_app
# Long random string. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_DB_PASSWORD=change-me-to-a-long-random-string

# Public address of the site (no trailing slash). Used in invite links.
BASE_URL=http://localhost:8000
COMPANY_NAME=
# Local development over http needs this false. Always true in production.
COOKIE_SECURE=false

TIMEZONE=Africa/Lagos
# Per-weekday schedule (decision D5). Empty = the defaults in app/rules/schedule.py.
# Example:
# SCHEDULE_JSON={"mon":{"start":"08:00","grace":10,"close":"17:00"},"tue":{"start":"08:00","grace":10,"close":"17:00"},"wed":{"start":"08:00","grace":10,"close":"17:00"},"thu":{"start":"10:00","grace":10,"close":"17:00"},"fri":{"start":"08:00","grace":10,"close":"17:00"},"sat":{"start":"08:00","grace":5,"close":"15:00"},"sun":null}
SCHEDULE_JSON=
# Comma-separated dates that are not working days.
HOLIDAYS=
